# Copier en .env (bin/install.php le fait automatiquement et génère les secrets).
# NE JAMAIS versionner le fichier .env.

APP_ENV=local
APP_DEBUG=0
# URL publique, sans barre finale. En production : https://votre-domaine.ci
APP_URL=http://localhost:8000
# Clé secrète (64 caractères hexadécimaux) — générée par bin/install.php
APP_KEY=

# Base de données : mysql (MariaDB/MySQL) ou sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miel_pur
DB_USERNAME=miel
DB_PASSWORD=
# Pour SQLite : DB_DRIVER=sqlite et DB_DATABASE=database.sqlite (fichier créé dans storage/)

# E-mails : log (écrit dans storage/mail, rien n'est envoyé) ou mail (fonction mail() du serveur)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.ci
MAIL_FROM_NAME="Miel Pur de Côte d'Ivoire"

# Paiement SIMULÉ (démonstration). Mettre 0 en production.
DEMO_PAYMENT_ENABLED=1
DEMO_PAYMENT_SECRET=

# Prestataires NON INTÉGRÉS : laisser vide tant que l'intégration n'est pas développée et testée.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
CARD_PROVIDER=
CARD_API_KEY=
CARD_WEBHOOK_SECRET=

# Derrière un proxy inverse / CDN : IP du proxy de confiance (sinon laisser vide)
TRUSTED_PROXY=

# Délai minimal (secondes) avant l'envoi d'un formulaire public (anti-robot)
ANTISPAM_MIN_SECONDS=3

# Sauvegardes : nombre d'archives conservées
BACKUP_KEEP=14
