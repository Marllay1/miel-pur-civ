# Copier en .env (bin/install.php le fait automatiquement et génère les secrets).
# NE JAMAIS versionner le fichier .env. Une variable vide = fonctionnalité désactivée.

APP_ENV=local
APP_DEBUG=0
# URL publique, sans barre finale. En production : https://votre-domaine.ci
APP_URL=http://localhost:8000
# Clé secrète (64 caractères hexadécimaux) — générée par bin/install.php
APP_KEY=
# Adresse IP du proxy inverse de confiance (ex. 127.0.0.1 derrière Nginx/Cloudflare) ; vide = aucun
TRUSTED_PROXY=
# Délai minimal (secondes) avant l'envoi d'un formulaire public (anti-robot)
ANTISPAM_MIN_SECONDS=3
# Nombre de sauvegardes conservées par bin/backup.php
BACKUP_KEEP=14

# Base de données : mysql (MariaDB/MySQL) ou sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miel_pur
DB_USERNAME=miel
DB_PASSWORD=
# Pour SQLite : DB_DRIVER=sqlite et DB_DATABASE=database.sqlite (fichier créé dans storage/)

# E-mails : smtp (recommandé), mail (fonction mail() du serveur) ou log (écrit dans storage/mail, rien n'est envoyé)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.ci
MAIL_FROM_NAME="Miel Pur de Côte d'Ivoire"
# SMTP — identifiants fournis par l'hébergeur ou le service d'e-mail (Brevo, Mailjet, Google Workspace, etc.)
SMTP_HOST=
# 587 avec tls (STARTTLS) ; 465 avec ssl ; none uniquement pour un serveur local de test
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=15
# 1 uniquement pour un serveur de test au certificat auto-signé. Toujours 0 en production.
SMTP_ALLOW_SELF_SIGNED=0

# Paiement SIMULÉ (aucune somme débitée) — réservé aux tests. Toujours 0 en production.
DEMO_PAYMENT_ENABLED=0
DEMO_PAYMENT_SECRET=

# ── Paiements en ligne ─────────────────────────────────────────────
# Un moyen de paiement n'apparaît au client que si TOUTES ses variables obligatoires sont renseignées
# ET qu'il est activé dans Administration → Intégrations. Voir docs/INTEGRATIONS.md.

# Wave (API Checkout) — obligatoire : WAVE_API_KEY, WAVE_WEBHOOK_SECRET
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Uniquement si la clé API a été créée avec la signature de requêtes
WAVE_SIGNING_SECRET=
WAVE_API_BASE=https://api.wave.com

# Orange Money WebPay — obligatoire : CLIENT_ID, CLIENT_SECRET, MERCHANT_KEY, PATH
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Chemin communiqué par Orange (bac à sable : /orange-money-webpay/dev/v1)
ORANGE_MONEY_PATH=
# Bac à sable : OUV ; production : XOF
ORANGE_MONEY_CURRENCY=XOF
ORANGE_MONEY_API_BASE=https://api.orange.com

# MTN Mobile Money (Collection) — obligatoire : SUBSCRIPTION_KEY, API_USER, API_KEY, TARGET_ENV
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# Valeur communiquée par MTN (bac à sable : sandbox, devise EUR)
MTN_MOMO_TARGET_ENV=
MTN_MOMO_CURRENCY=XOF
MTN_MOMO_API_BASE=https://proxy.momoapi.mtn.com

# Carte bancaire via CinetPay — obligatoire : API_KEY, SITE_ID, SECRET_KEY
# Le numéro de carte est saisi sur la page de CinetPay : il ne transite jamais par ce serveur.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_API_BASE=https://api-checkout.cinetpay.com

# ── Localisation à la commande (voir docs/LOCALISATION.md) ─────────
# Fonds de carte (Leaflet, servi par le site). Par défaut : serveurs OpenStreetMap, gratuits mais réservés à un usage
# modéré (politique d'utilisation des tuiles OSM). Pour un trafic important, utiliser un fournisseur dédié.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© contributeurs OpenStreetMap"
# Géocodage (adresse estimée), seulement si activé dans Paramètres du site → Livraison et commandes.
# Nominatim : 1 requête par seconde maximum, adresse de contact obligatoire (identification de l'application).
GEOCODER_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=
