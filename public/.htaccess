# Racine web (DocumentRoot) : dossier public/
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Fichiers cachés interdits
    RewriteRule (^|/)\. - [F,L]
    # Fichiers et dossiers existants servis directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|woff2|svg|png|webp|jpg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Compression des textes (HTML, CSS, JS, JSON, SVG, XML) : nécessite mod_deflate (activé par défaut sur la plupart
# des hébergements ; dans XAMPP : décommenter « LoadModule deflate_module » dans httpd.conf). Images WebP/PNG/JPEG déjà compressées.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml application/manifest+json image/svg+xml
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>
